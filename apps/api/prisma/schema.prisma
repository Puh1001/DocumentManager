generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// User & Authentication
// =====================

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  department   String? // LEGACY - kept for backward compatibility, will be deprecated after migration
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  // Relations
  roles                  UserRole[]
  sessions               Session[]
  documentVersions       DocumentVersion[]
  auditLogs              AuditLog[]
  folderPermissions      FolderPermission[]      @relation("UserFolderPermissions")
  docPermissions         DocumentPermission[]    @relation("UserDocumentPermissions")
  maintenanceNotices     MaintenanceNotice[]     @relation("MaintenanceNoticeCreator")
  maintenanceAttachments MaintenanceAttachment[] @relation("MaintenanceAttachmentCreator")
  departments            UserDepartment[] // NEW: Many-to-many relation with departments
  kpiAttachments         KpiAttachment[]         @relation("UserKpiAttachments")

  // Deletion tracking relations
  uploadedDocuments Document[]        @relation("UploadedDocuments")
  deletionRequests  DeletionRequest[] @relation("DeletionRequests")
  deletionReviews   DeletionRequest[] @relation("DeletionReviews")

  // ISO document workflow relations
  preparedDocuments Document[] @relation("DocumentPreparer")
  reviewedDocuments Document[] @relation("DocumentReviewer")
  approvedDocuments Document[] @relation("DocumentApprover")

  @@index([username])
  @@index([email])
  @@index([department])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  users             UserRole[]
  permissions       RolePermission[]
  folderPermissions FolderPermission[]   @relation("RoleFolderPermissions")
  docPermissions    DocumentPermission[] @relation("RoleDocumentPermissions")

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =====================
// Permissions
// =====================

model Module {
  id          String  @id @default(uuid())
  name        String  @unique // "User", "Department", etc.
  displayName String  @map("display_name") // "User Management"
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("modules")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // view, download, print, edit, create, delete, manage
  description String?

  // Relations
  rolePermissions     RolePermission[]
  folderPermissions   FolderPermission[]
  documentPermissions DocumentPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =====================
// Folders & Documents
// =====================

model Folder {
  id               String              @id @default(uuid())
  name             String
  path             String              @unique // SMB relative path
  parentId         String?             @map("parent_id")
  physicalLocation String?             @map("physical_location") // Vị trí lưu trữ bản cứng
  departmentId     String?             @map("department_id") // Link to department
  isInternal       Boolean             @default(false) @map("is_internal") // Internal/system folder (hidden from normal users)
  internalType     InternalFolderType? @map("internal_type") // VERSIONS, DELETE_FILES, etc.
  deletedAt        DateTime?           @map("deleted_at") // Soft delete timestamp
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  // Self-relation for hierarchy
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Folder[] @relation("FolderHierarchy")

  // Relations
  department  Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  documents   Document[]
  permissions FolderPermission[]

  @@index([parentId])
  @@index([path])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("folders")
}

enum InternalFolderType {
  VERSIONS
  DELETE_FILES
}

// ISO document level lookup (stored in DB, not hardcoded)
model DocumentLevel {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. LEVEL1, LEVEL2
  name        String // Default display name
  nameEn      String?  @map("name_en")
  nameVi      String?  @map("name_vi")
  nameZh      String?  @map("name_zh")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  documents Document[]

  @@index([code])
  @@index([isActive])
  @@index([sortOrder])
  @@map("document_levels")
}

model Document {
  id             String         @id @default(uuid())
  name           String // Display name
  fileName       String         @map("file_name") // Original filename
  fileType       String         @map("file_type") // pdf, docx, xlsx, etc.
  mimeType       String?        @map("mime_type") // MIME type (e.g., application/pdf)
  fileSize       Int            @map("file_size") // bytes
  filePath       String         @map("file_path") // SMB path to current version
  checksum       String // SHA-256 for integrity
  fileCreatedAt  DateTime?      @map("file_created_at") // File creation date from file system
  fileModifiedAt DateTime?      @map("file_modified_at") // File modification date from file system
  folderId       String         @map("folder_id")
  status         DocumentStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // ISO document level (optional - required for ISO documents, null for client files)
  levelId String? @map("level_id")

  // Business document number (No.) entered by user
  documentNo String? @map("document_no")

  // Revision label: A/0 (original), A/1..A/10, then B/0..B/10, etc.
  revisionLabel String? @map("revision_label")

  // ISO metadata (auto-populated by system)
  preparerId      String?   @map("preparer_id") // Auto-set to uploader (legacy, kept for backward compatibility)
  reviewerId      String?   @map("reviewer_id") // Legacy, kept for backward compatibility
  approverId      String?   @map("approver_id") // Legacy, kept for backward compatibility
  preparerName    String?   @map("preparer_name") // Full name entered by user
  reviewerName    String?   @map("reviewer_name") // Full name entered by user
  approverName    String?   @map("approver_name") // Full name entered by user
  approvalDate    DateTime? @map("approval_date")
  receiptDate     DateTime? @map("receipt_date")
  storageLocation String?   @map("storage_location") // Physical storage location entered by user

  // Deletion tracking fields
  uploadedBy        String?   @map("uploaded_by") // Uploader user ID
  uploadedAt        DateTime? @default(now()) @map("uploaded_at") // Upload timestamp
  deletionExpiresAt DateTime? @map("deletion_expires_at") // uploadedAt + 72h

  // Relations
  folder                 Folder                  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  level                  DocumentLevel?          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  preparer               User?                   @relation("DocumentPreparer", fields: [preparerId], references: [id], onDelete: SetNull)
  reviewer               User?                   @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  approver               User?                   @relation("DocumentApprover", fields: [approverId], references: [id], onDelete: SetNull)
  versions               DocumentVersion[]
  permissions            DocumentPermission[]
  kpiAttachments         KpiAttachment[]         @relation("DocumentKpiAttachments")
  maintenanceAttachments MaintenanceAttachment[] @relation("DocumentMaintenanceAttachments")

  // Composite unique constraint on folderId + fileName to prevent duplicates
  @@unique([folderId, fileName], name: "document_folder_file_unique")

  // Deletion tracking relations
  uploadedByUser  User?             @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: SetNull)
  deletionRequest DeletionRequest?
  replacementFor  DeletionRequest[] @relation("ReplacementFiles")

  @@index([folderId])
  @@index([levelId])
  @@index([preparerId])
  @@index([reviewerId])
  @@index([approverId])
  @@index([approvalDate])
  @@index([receiptDate])
  @@index([status])
  @@index([fileType])
  @@index([uploadedBy])
  @@index([deletionExpiresAt])
  @@index([documentNo])
  @@index([revisionLabel])
  @@map("documents")
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// =====================
// Deletion Requests
// =====================

model DeletionRequest {
  id                String        @id @default(uuid())
  documentId        String        @unique @map("document_id") // One request per document
  requestedBy       String        @map("requested_by")
  requestedAt       DateTime      @default(now()) @map("requested_at")
  reason            String        @db.Text // Reason for deletion
  replacementFileId String?       @map("replacement_file_id") // Optional replacement
  status            RequestStatus @default(PENDING)
  reviewedBy        String?       @map("reviewed_by") // DCC reviewer
  reviewedAt        DateTime?     @map("reviewed_at")
  reviewerComment   String?       @map("reviewer_comment") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requester       User      @relation("DeletionRequests", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewer        User?     @relation("DeletionReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)
  replacementFile Document? @relation("ReplacementFiles", fields: [replacementFileId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([requestedBy])
  @@index([status])
  @@index([reviewedBy])
  @@index([status, requestedAt]) // Composite index for DCC dashboard queries
  @@map("deletion_requests")
}

// =====================
// Version Control
// =====================

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  version    Int
  fileName   String   @map("file_name")
  filePath   String   @map("file_path") // Path to versioned file
  fileSize   Int      @map("file_size")
  checksum   String
  comment    String? // Change description
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [createdBy], references: [id])

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

// =====================
// Folder & Document Permissions
// =====================

model FolderPermission {
  id           String      @id @default(uuid())
  folderId     String      @map("folder_id")
  subjectType  SubjectType @map("subject_type")
  subjectId    String      @map("subject_id")
  permissionId String      @map("permission_id")
  inherit      Boolean     @default(true) // Apply to subfolders & documents

  folder     Folder     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Conditional relations based on subjectType
  user User? @relation("UserFolderPermissions", fields: [subjectId], references: [id], map: "folder_perm_user_fk")
  role Role? @relation("RoleFolderPermissions", fields: [subjectId], references: [id], map: "folder_perm_role_fk")

  @@unique([folderId, subjectType, subjectId, permissionId])
  @@index([folderId])
  @@index([subjectId])
  @@map("folder_permissions")
}

model DocumentPermission {
  id           String      @id @default(uuid())
  documentId   String      @map("document_id")
  subjectType  SubjectType @map("subject_type")
  subjectId    String      @map("subject_id")
  permissionId String      @map("permission_id")

  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Conditional relations
  user User? @relation("UserDocumentPermissions", fields: [subjectId], references: [id], map: "doc_perm_user_fk")
  role Role? @relation("RoleDocumentPermissions", fields: [subjectId], references: [id], map: "doc_perm_role_fk")

  @@unique([documentId, subjectType, subjectId, permissionId])
  @@index([documentId])
  @@index([subjectId])
  @@map("document_permissions")
}

enum SubjectType {
  USER
  ROLE
}

// =====================
// Audit Log
// =====================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String // LOGIN, LOGOUT, VIEW, DOWNLOAD, UPLOAD, EDIT, DELETE, PERMISSION_CHANGE
  resourceType String?  @map("resource_type") // Document, Folder, User
  resourceId   String?  @map("resource_id")
  details      Json? // Additional context
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =====================
// KPI Tracking
// =====================

model UserDepartment {
  userId       String   @map("user_id")
  departmentId String   @map("department_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_departments")
}

model Department {
  id        String   @id @default(uuid())
  name      String // Vietnamese name (default, for backward compatibility)
  nameEn    String?  @map("name_en") // English name
  nameVi    String?  @map("name_vi") // Vietnamese name
  nameZh    String?  @map("name_zh") // Chinese name
  code      String   @unique // e.g., "BOD", "HCNS"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  folders            Folder[]
  kpiRecords         KpiRecord[]
  maintenanceNotices MaintenanceNotice[]
  users              UserDepartment[] // NEW: Many-to-many relation with users

  @@index([code])
  @@map("departments")
}

model KpiRecord {
  id           String      @id @default(uuid())
  departmentId String      @map("department_id")
  year         Int // e.g., 2024
  title        String // e.g., "梭织转机效率 Hiệu quả chuyển máy dệt thoi"
  target       String // e.g., "≥85%"
  targetValue  Float?      @map("target_value") // numeric: 85
  displayType  DisplayType @default(PERCENTAGE) @map("display_type") // PERCENTAGE or COUNT
  rowMode      RowMode?    @map("row_mode") // SINGLE (1 row) or DOUBLE (2 rows), only for COUNT
  status       KpiStatus   @default(PENDING) @map("status") // Track completion status
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  createdBy    String?     @map("created_by")

  department  Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  metrics     KpiMetric[]
  attachments KpiAttachment[] @relation("KpiRecordAttachments")

  @@unique([departmentId, year, title])
  @@index([departmentId])
  @@index([year])
  @@index([status])
  @@map("kpi_records")
}

enum DisplayType {
  PERCENTAGE // Default: show efficiency calculations (%)
  COUNT // Show only actual counts vs targets (数量)
}

enum RowMode {
  SINGLE // 1 dòng: ACTUAL only
  DOUBLE // 2 dòng: TARGET + ACTUAL
}

enum KpiStatus {
  PENDING // Initial state, no files uploaded
  IN_PROGRESS // Work started (manual only)
  COMPLETED // Files uploaded or manually marked complete
}

enum MetricType {
  TARGET // 理论转机数量 - theoretical/target values
  ACTUAL // 转机实际 - actual values
  CALCULATED // 梭织转机效率 - auto-calculated
}

model KpiMetric {
  id          String     @id @default(uuid())
  kpiRecordId String     @map("kpi_record_id")
  name        String // e.g., "理论转机数量 (台) Số máy cần chuyển (máy)"
  type        MetricType @default(TARGET)
  sortOrder   Int        @map("sort_order")
  // Monthly values stored as JSON: {"m1": 599, "m2": 495, ...}
  values      Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  kpiRecord KpiRecord @relation(fields: [kpiRecordId], references: [id], onDelete: Cascade)

  @@index([kpiRecordId])
  @@map("kpi_metrics")
}

model KpiAttachment {
  id          String   @id @default(uuid())
  kpiRecordId String   @map("kpi_record_id")
  documentId  String   @map("document_id")
  month       Int?     @map("month") // 1-12; NULL = legacy, shown in every month
  description String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  kpiRecord KpiRecord @relation("KpiRecordAttachments", fields: [kpiRecordId], references: [id], onDelete: Cascade)
  document  Document  @relation("DocumentKpiAttachments", fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User      @relation("UserKpiAttachments", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([kpiRecordId])
  @@index([kpiRecordId, month])
  @@index([documentId])
  @@index([createdById])
  @@map("kpi_attachments")
}

// =====================
// Maintenance Notices
// =====================

model MaintenanceNotice {
  id           String   @id @default(uuid())
  title        String
  description  String?
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  departmentId String?  @map("department_id")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator    User        @relation("MaintenanceNoticeCreator", fields: [createdBy], references: [id])

  attachments MaintenanceAttachment[]

  @@index([departmentId])
  @@index([startDate])
  @@index([createdBy])
  @@map("maintenance_notices")
}

model MaintenanceAttachment {
  id                  String   @id @default(uuid())
  maintenanceNoticeId String   @map("maintenance_notice_id")
  documentId          String   @map("document_id")
  description         String?
  createdById         String   @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")

  maintenanceNotice MaintenanceNotice @relation(fields: [maintenanceNoticeId], references: [id], onDelete: Cascade)
  document          Document          @relation("DocumentMaintenanceAttachments", fields: [documentId], references: [id], onDelete: Cascade)
  createdBy         User              @relation("MaintenanceAttachmentCreator", fields: [createdById], references: [id])

  @@index([maintenanceNoticeId])
  @@index([documentId])
  @@index([createdById])
  @@map("maintenance_attachments")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// User & Authentication
// =====================

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  department   String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  // Relations
  roles             UserRole[]
  sessions          Session[]
  documentVersions  DocumentVersion[]
  auditLogs         AuditLog[]
  folderPermissions FolderPermission[]  @relation("UserFolderPermissions")
  docPermissions    DocumentPermission[] @relation("UserDocumentPermissions")

  @@map("users")
  @@index([username])
  @@index([email])
  @@index([department])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  users             UserRole[]
  permissions       RolePermission[]
  folderPermissions FolderPermission[] @relation("RoleFolderPermissions")
  docPermissions    DocumentPermission[] @relation("RoleDocumentPermissions")

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
  @@index([expiresAt])
}

// =====================
// Permissions
// =====================

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // view, download, print, edit, create, delete, manage
  description String?

  // Relations
  rolePermissions     RolePermission[]
  folderPermissions   FolderPermission[]
  documentPermissions DocumentPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =====================
// Folders & Documents
// =====================

model Folder {
  id               String    @id @default(uuid())
  name             String
  path             String    @unique // SMB relative path
  parentId         String?   @map("parent_id")
  physicalLocation String?   @map("physical_location") // Vị trí lưu trữ bản cứng
  deletedAt        DateTime? @map("deleted_at") // Soft delete timestamp
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Self-relation for hierarchy
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Folder[] @relation("FolderHierarchy")

  // Relations
  documents   Document[]
  permissions FolderPermission[]

  @@map("folders")
  @@index([parentId])
  @@index([path])
  @@index([deletedAt])
}

model Document {
  id        String         @id @default(uuid())
  name      String // Display name
  fileName  String         @map("file_name") // Original filename
  fileType  String         @map("file_type") // pdf, docx, xlsx, etc.
  fileSize  Int            @map("file_size") // bytes
  filePath  String         @map("file_path") // SMB path to current version
  checksum  String // SHA-256 for integrity
  folderId  String         @map("folder_id")
  status    DocumentStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  // Relations
  folder      Folder               @relation(fields: [folderId], references: [id], onDelete: Cascade)
  versions    DocumentVersion[]
  permissions DocumentPermission[]

  @@map("documents")
  @@index([folderId])
  @@index([status])
  @@index([fileType])
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// =====================
// Version Control
// =====================

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  version    Int
  fileName   String   @map("file_name")
  filePath   String   @map("file_path") // Path to versioned file
  fileSize   Int      @map("file_size")
  checksum   String
  comment    String? // Change description
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [createdBy], references: [id])

  @@unique([documentId, version])
  @@map("document_versions")
  @@index([documentId])
}

// =====================
// Folder & Document Permissions
// =====================

model FolderPermission {
  id           String      @id @default(uuid())
  folderId     String      @map("folder_id")
  subjectType  SubjectType @map("subject_type")
  subjectId    String      @map("subject_id")
  permissionId String      @map("permission_id")
  inherit      Boolean     @default(true) // Apply to subfolders & documents

  folder     Folder     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Conditional relations based on subjectType
  user User? @relation("UserFolderPermissions", fields: [subjectId], references: [id], map: "folder_perm_user_fk")
  role Role? @relation("RoleFolderPermissions", fields: [subjectId], references: [id], map: "folder_perm_role_fk")

  @@unique([folderId, subjectType, subjectId, permissionId])
  @@map("folder_permissions")
  @@index([folderId])
  @@index([subjectId])
}

model DocumentPermission {
  id           String      @id @default(uuid())
  documentId   String      @map("document_id")
  subjectType  SubjectType @map("subject_type")
  subjectId    String      @map("subject_id")
  permissionId String      @map("permission_id")

  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Conditional relations
  user User? @relation("UserDocumentPermissions", fields: [subjectId], references: [id], map: "doc_perm_user_fk")
  role Role? @relation("RoleDocumentPermissions", fields: [subjectId], references: [id], map: "doc_perm_role_fk")

  @@unique([documentId, subjectType, subjectId, permissionId])
  @@map("document_permissions")
  @@index([documentId])
  @@index([subjectId])
}

enum SubjectType {
  USER
  ROLE
}

// =====================
// Audit Log
// =====================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String // LOGIN, LOGOUT, VIEW, DOWNLOAD, UPLOAD, EDIT, DELETE, PERMISSION_CHANGE
  resourceType String?  @map("resource_type") // Document, Folder, User
  resourceId   String?  @map("resource_id")
  details      Json? // Additional context
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

